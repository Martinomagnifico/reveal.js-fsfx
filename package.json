{
	"name": "reveal.js-fsfx",
	"version": "1.3.0",
	"description": "A plugin for Reveal.js that enters or exits fullscreen, and toggles classes on certain elements",
	"keywords": [
		"reveal",
		"reveal.js",
		"reveal-plugin",
		"plugin",
		"fullscreen",
		"screenfull"
	],
	"homepage": "https://github.com/martinomagnifico/reveal.js-fsfx",
	"license": "MIT",
	"author": {
		"name": "Martijn De Jongh (Martino)",
		"email": "martijn.de.jongh@gmail.com",
		"web": "https://martinomagnifico.github.io",
		"url": "https://martinomagnifico.github.io",
		"username": "martinomagnifico"
	},
	"repository": {
		"type": "git",
		"url": "git://github.com/martinomagnifico/reveal.js-fsfx.git"
	},
	"type": "module",
	"main": "./plugin/fsfx/fsfx.js",
	"module": "./plugin/fsfx/fsfx.mjs",
	"exports": {
		".": {
			"import": "./plugin/fsfx/fsfx.mjs",
			"require": "./plugin/fsfx/fsfx.js"
		},
		"./plugin/fsfx/fsfx.esm.js": "./plugin/fsfx/fsfx.mjs",
		"./plugin/fsfx/fsfx.css": "./plugin/fsfx/fsfx.css"
	},
	"files": [
		"plugin/fsfx",
		"CHANGELOG.md"
	],
	"scripts": {
		"start": "npm run dev",
		"copy-reveal": "node scripts/copy-reveal.mjs",
		"copy-plugin": "node scripts/copy-plugin.mjs",
		"dev": "vite",
		"prebuild": "rimraf demo plugin",
		"build-plugin": "vite build -c vite.lib.config.ts",
		"build-css": "sass src/plugin/css/index.scss demo/plugin/fsfx/fsfx.css --no-source-map --style=expanded",
		"build-demo": "vite build -c vite.config.ts",
		"build": "npm run build-plugin && npm run build-css && npm run build-demo && npm run copy-reveal && npm run copy-plugin",
		"format": "biome format --write .",
		"lint": "biome lint .",
		"check": "biome check --write .",
		"preview": "npm run build && vite preview",
		"ci": "biome ci ."
	},
	"peerDependencies": {
		"reveal.js": ">=4.0.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.10",
		"@types/node": "^26.2.0",
		"@types/reveal.js": "^5.2.2",
		"@vituum/vite-plugin-pug": "^2.0.1",
		"fs-extra": "^11.4.0",
		"reveal.js-plugintoolkit": "^1.2.2",
		"rimraf": "^6.1.3",
		"sass": "^1.103.1",
		"screenfull": "^6.0.2",
		"typescript": "^7.0.2",
		"vite": "^8.2.2",
		"vituum": "^2.0.2"
	}
}
