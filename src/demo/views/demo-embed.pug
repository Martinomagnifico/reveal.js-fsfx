extends templates/layouts/_reveal-embed.pug

append variables
	- presentation.title = presentation.title + ": embedded"

//- Deck one has the generated button in its default corner, top right. Deck two
//- has it bottom left, so both placements are on the page at once. Fullscreen
//- takes the deck itself, not the page.
block slides
	include slides/_slides

block slidestwo
	include slides/_slides

append styles
	style.
		body { background: var(--r-background-color); }

block append scripts
	if process.env.NODE_ENV === 'production'
		script(src=`plugin/${plugin.name}/${plugin.name}.js`)
		script.
			const deck1 = new Reveal(document.querySelector("#deck1"), {
				embedded: true,
				keyboardCondition: "focused",
				controlsTutorial: false,
				plugins: [ FsFx ],
				fsfx: {
					compatibility: false
				}
			});

			const deck2 = new Reveal(document.querySelector("#deck2"), {
				embedded: true,
				keyboardCondition: "focused",
				controlsTutorial: false,
				plugins: [ FsFx ],
				fsfx: {
					compatibility: false,
					auto: {
						position: { bottom: "20px", left: "20px" }
					}
				}
			});

			deck1.initialize();
			deck2.initialize();
	else
		script(type="module").
			import "/src/plugin/css/index.scss";
			import FsFx from '@/plugin/js/index';

			const deck1 = new Reveal(document.querySelector("#deck1"), {
				embedded: true,
				keyboardCondition: "focused",
				controlsTutorial: false,
				plugins: [ FsFx ],
				fsfx: {
					compatibility: false,
					cssautoload: false,
					debug: true
				}
			});

			const deck2 = new Reveal(document.querySelector("#deck2"), {
				embedded: true,
				keyboardCondition: "focused",
				controlsTutorial: false,
				plugins: [ FsFx ],
				fsfx: {
					compatibility: false,
					cssautoload: false,
					debug: true,
					auto: {
						position: { bottom: "20px", left: "20px" }
					}
				}
			});

			deck1.initialize();
			deck2.initialize();
